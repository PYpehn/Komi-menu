-- ============================================================
local function ChangeBackground(url)
    -- WindUI creates the background in the ScreenGui
    -- Find it by searching all descendants
    local found = false
    for _, gui in ipairs(game:GetService("CoreGui"):GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Name ~= "LoadingScreen" then
            for _, obj in ipairs(gui:GetDescendants()) do
                if obj:IsA("ImageLabel") then
                    -- Check if it looks like the background (large, named or has the current bg)
                    if obj.Size == UDim2.new(1, 0, 1, 0) or obj.Name == "Background" or obj.Image == DEFAULT_BG then
                        obj.Image = url
                        found = true
                    end
                end
            end
        end
    end
    return found
end


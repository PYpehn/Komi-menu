local function startSpray()
    if sprayConnection then sprayConnection:Disconnect() end
    
    sprayConnection = RunService.RenderStepped:Connect(function()
        if not sprayEnabled then return end
        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            local tool = player.Character and player.Character:FindFirstChildOfClass("Tool")
            if tool then
                tool:Activate()
            end
        else
            local tool = player.Character and player.Character:FindFirstChildOfClass("Tool")
            if tool then
                pcall(function() tool:Deactivate() end)
            end
        end
    end)
end

local function stopSpray()
    sprayEnabled = false
    if sprayConnection then sprayConnection:Disconnect() sprayConnection = nil end
    local tool = player.Character and player.Character:FindFirstChildOfClass("Tool")
    if tool then pcall(function() tool:Deactivate() end) end
end

local function createImageOverlay(url)
    if imageOverlay then imageOverlay:Destroy() end
    local gui = Instance.new("ScreenGui")
    gui.Name = "ImageOverlay"
    gui.Parent = player.PlayerGui
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 10
    local img = Instance.new("ImageLabel")
    img.Size = UDim2.new(1, 0, 1, 0)
    img.BackgroundTransparency = 1
    img.Image = url
    img.ScaleType = Enum.ScaleType.Fit
    img.ImageTransparency = 0.6
    img.Parent = gui
    imageOverlay = gui
end

local function removeImageOverlay()
    if imageOverlay then imageOverlay:Destroy() imageOverlay = nil end
end

local function startAutoDraw(points, speed)
    if autoDrawing then return end
    local tool = player.Character and player.Character:FindFirstChildOfClass("Tool")
    if not tool then WindUI:Notify({Title="Auto Drawer", Content="Equip a spray tool first!", Duration=3}) return end
    
    autoDrawing = true
    local cx, cy = Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2
    
    autoDrawThread = task.spawn(function()
        tool:Activate()
        for _, pt in ipairs(points) do
            if not autoDrawing then break end
            local ray = Camera:ScreenPointToRay(cx + pt[1], cy + pt[2])
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + ray.Direction * 10)
            task.wait(speed or 0.02)
        end
        pcall(function() tool:Deactivate() end)
        autoDrawing = false
        WindUI:Notify({Title="Auto Drawer", Content="Done!", Duration=2})
    end)
end

local function stopAutoDraw()
    autoDrawing = false
    if autoDrawThread then task.cancel(autoDrawThread) end
    local tool = player.Character and player.Character:FindFirstChildOfClass("Tool")
    if tool then pcall(function() tool:Deactivate() end) end
end

local function traceImageFromUrl(url)
    if autoDrawing then return end
    local tool = player.Character and player.Character:FindFirstChildOfClass("Tool")
    if not tool then WindUI:Notify({Title="Auto Drawer", Content="Equip a spray tool first!", Duration=3}) return end
    
    WindUI:Notify({Title="Auto Drawer", Content="Processing image...", Duration=3})
    
    local temp = Instance.new("ImageLabel")
    temp.Image = url
    temp.Visible = false
    temp.Parent = player.PlayerGui
    task.wait(2)
    local w, h = temp.ContentImageSize.X, temp.ContentImageSize.Y
    if w == 0 or h == 0 then w, h = 256, 256 end
    temp:Destroy()
    
    local pts = {}
    local grid = 10
    local sw, sh = Camera.ViewportSize.X, Camera.ViewportSize.Y
    local dw, dh = sw * 0.4, sh * 0.4
    local ox, oy = (sw - dw)/2, (sh - dh)/2
    for y = 0, h, grid do
        for x = 0, w, grid do
            table.insert(pts, {ox + (x/w)*dw - sw/2, oy + (y/h)*dh - sh/2})
        end
    end
    if #pts > 0 then startAutoDraw(pts, 0.003) end
end


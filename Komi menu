-- ====== MAIN TAB ======
Window:Tab({
    Title = "Main",
    Icon = "warehouse",
})

Window:Section({
    Title = "Player Settings",
})

-- Walk Speed
Window:Slider({
    Title = "Walk Speed",
    Desc = "Adjust movement speed",
    Flag = "walkSpeed",
    Value = { Min = 16, Max = 100, Default = 50 },
    Callback = function(value)
        local plr = game.Players.LocalPlayer
        if plr and plr.Character then
            local hum = plr.Character:FindFirstChild("Humanoid")
            if hum then hum.WalkSpeed = value end
        end
    end
})

-- Jump Power
Window:Slider({
    Title = "Jump Power",
    Desc = "Adjust jump height",
    Flag = "jumpPower",
    Value = { Min = 50, Max = 200, Default = 50 },
    Callback = function(value)
        local plr = game.Players.LocalPlayer
        if plr and plr.Character then
            local hum = plr.Character:FindFirstChild("Humanoid")
            if hum then hum.JumpPower = value end
        end
    end
})

Window:Divider()

Window:Toggle({
    Title = "Infinite Jump",
    Desc = "Jump in mid-air",
    Flag = "infiniteJump",
    Value = false,
    Callback = function(state)
        _G.InfiniteJump = state
    end
})

Window:Toggle({
    Title = "Fly Mode",
    Desc = "Enable flight",
    Flag = "flyMode",
    Value = false,
    Callback = function(state)
        local plr = game.Players.LocalPlayer
        if plr and plr.Character then
            local hum = plr.Character:FindFirstChild("Humanoid")
            if hum then
                hum.PlatformStand = state
                local root = plr.Character:FindFirstChild("HumanoidRootPart")
                if root then root.Anchored = state end
            end
        end
    end
})


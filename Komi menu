--  LOADING SCREEN
-- ============================================================
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local VirtualInputManager = game:GetService("VirtualInputManager")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer

-- Detect mobile (touch enabled, no physical keyboard)
local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

local loadingGui = Instance.new("ScreenGui")
loadingGui.Name = "LoadingScreen"
loadingGui.Parent = player:WaitForChild("PlayerGui")
loadingGui.ResetOnSpawn = false
loadingGui.DisplayOrder = 999

local bgFrame = Instance.new("Frame")
bgFrame.Size = UDim2.new(1, 0, 1, 0)
bgFrame.BackgroundColor3 = Color3.fromRGB(10, 10, 20)
bgFrame.BorderSizePixel = 0
bgFrame.Parent = loadingGui

local title = Instance.new("TextLabel")
title.Size = UDim2.new(0, 300, 0, 40)
title.Position = UDim2.new(0.5, -150, 0.5, -60)
title.Text = "Advanced Hub"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.BackgroundTransparency = 1
title.Font = Enum.Font.GothamBlack
title.TextSize = 28
title.Parent = bgFrame

local subtitle = Instance.new("TextLabel")
subtitle.Size = UDim2.new(0, 300, 0, 20)
subtitle.Position = UDim2.new(0.5, -150, 0.5, -10)
subtitle.Text = "Loading..."
subtitle.TextColor3 = Color3.fromRGB(180, 180, 200)
subtitle.BackgroundTransparency = 1
subtitle.Font = Enum.Font.Gotham
subtitle.TextSize = 14
subtitle.Parent = bgFrame

local barBg = Instance.new("Frame")
barBg.Size = UDim2.new(0, 300, 0, 4)
barBg.Position = UDim2.new(0.5, -150, 0.5, 20)
barBg.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
barBg.BorderSizePixel = 0
barBg.Parent = bgFrame

local barFill = Instance.new("Frame")
barFill.Size = UDim2.new(0, 0, 1, 0)
barFill.BackgroundColor3 = Color3.fromRGB(100, 100, 255)
barFill.BorderSizePixel = 0
barFill.Parent = barBg

local credit = Instance.new("TextLabel")
credit.Size = UDim2.new(0, 300, 0, 20)
credit.Position = UDim2.new(0.5, -150, 0.5, 40)
credit.Text = "Reworked by Nothing"
credit.TextColor3 = Color3.fromRGB(80, 80, 100)
credit.BackgroundTransparency = 1
credit.Font = Enum.Font.Gotham
credit.TextSize = 11
credit.Parent = bgFrame

local loadingDone = false
local startTime = tick()
local totalDuration = 3
local conn
conn = RunService.RenderStepped:Connect(function()
    local elapsed = tick() - startTime
    local progress = math.min(elapsed / totalDuration, 1)
    barFill.Size = UDim2.new(progress, 0, 1, 0)
    if elapsed > 1 then subtitle.Text = "Initializing..." end
    if elapsed > 2 then subtitle.Text = "Almost ready..." end
    if progress >= 1 then
        conn:Disconnect()
        local fade = TweenService:Create(bgFrame, TweenInfo.new(0.3), {BackgroundTransparency = 1})
        fade:Play()
        fade.Completed:Connect(function()
            loadingGui:Destroy()
            loadingDone = true
        end)
    end
end)

repeat task.wait(0.1) until loadingDone


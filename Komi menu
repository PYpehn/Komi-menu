-- ====== SETTINGS TAB (NEW) ======
local SettingsTab = Window:Tab({
    Title = "Settings",
    Icon = "settings",
})

SettingsTab:Section({
    Title = "Background Customization",
    Icon = "image",
})

-- Input for background URL
local bgInput = SettingsTab:Input({
    Title = "Background URL",
    Desc = "Paste image URL (https://...) or Roblox asset ID",
    Icon = "link",
    Placeholder = "https://example.com/image.png",
    Value = DEFAULT_BG,
    Callback = function(text)
        -- No immediate change, user must click "Apply"
    end
})

-- Apply button
SettingsTab:Button({
    Title = "Apply Background",
    Icon = "check",
    IconAlign = "Left",
    Color = Color3.fromHex("#315dff"),
    Callback = function()
        local url = bgInput:GetValue()
        if url and url ~= "" then
            -- Try to set the background
            local success, err = pcall(function()
                Window:SetBackgroundImage(url)
            end)
            if success then
                WindUI:Notify({
                    Title = "Background Updated",
                    Content = "New background applied!",
                    Icon = "check",
                    Duration = 2
                })
            else
                WindUI:Notify({
                    Title = "Error",
                    Content = "Failed to set background: " .. tostring(err),
                    Icon = "x",
                    Duration = 3
                })
            end
        end
    end
})

-- Transparency slider
SettingsTab:Slider({
    Title = "Background Transparency",
    Desc = "0 = opaque, 1 = fully transparent",
    Flag = "bgTransparency",
    Value = { Min = 0, Max = 1, Default = 0.2 },
    Step = 0.05,
    Callback = function(value)
        pcall(function()
            Window:SetBackgroundImageTransparency(value)
        end)
    end
})

SettingsTab:Divider()

SettingsTab:Section({
    Title = "Preset Backgrounds",
    Icon = "palette",
})

-- List of preset backgrounds (you can add your own)
local Presets = {
    { Name = "Space", URL = "https://i.imgur.com/8Km9tLL.jpeg" },
    { Name = "Neon City", URL = "https://i.imgur.com/ZNz3XQx.jpeg" },
    { Name = "Dark Gradient", URL = "rbxassetid://10618928818" },
    { Name = "Cyberpunk", URL = "https://i.imgur.com/1J5Qk2v.jpeg" },
}

for _, preset in ipairs(Presets) do
    SettingsTab:Button({
        Title = preset.Name,
        Icon = "image",
        IconAlign = "Left",
        Callback = function()
            pcall(function()
                Window:SetBackgroundImage(preset.URL)
                bgInput:SetValue(preset.URL)   -- Update the input field
                WindUI:Notify({
                    Title = "Preset Applied",
                    Content = preset.Name .. " background set!",
                    Icon = "check",
                    Duration = 2
                })
            end)
        end
    })
end


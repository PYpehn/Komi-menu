-- ============================================================
--  MANUAL BACKGROUND (ImageLabel) – reliable even if built‑in fails
-- ============================================================
local function SetManualBackground(url, transparency)
    local mainFrame = Window.Holder or Window.Main or Window
    if not mainFrame then return end

    local oldBg = mainFrame:FindFirstChild("CustomBackground")
    if oldBg then oldBg:Destroy() end

    local bgImage = Instance.new("ImageLabel")
    bgImage.Name = "CustomBackground"
    bgImage.Image = url
    bgImage.ScaleType = Enum.ScaleType.Crop
    bgImage.Size = UDim2.new(1, 0, 1, 0)
    bgImage.BackgroundTransparency = 1
    bgImage.ImageTransparency = transparency or 0.2
    bgImage.ZIndex = -1
    bgImage.Parent = mainFrame
end

SetManualBackground(DEFAULT_BG, 0.2)


-- ============================================================
--  AUTO PICKUP (E‑spam) – only works if a keyboard is present
-- ============================================================
coroutine.wrap(function()
    while task.wait(0.001) do
        if getgenv().autoPickupEnabled then
            local key = getgenv().pickupKey
            VirtualInputManager:SendKeyEvent(true, key, false, game)
            task.wait(math.random(40, 70) / 1000)
            VirtualInputManager:SendKeyEvent(false, key, false, game)
            task.wait(getgenv().pickupDelay / 1000)
        else
            task.wait(0.1)
        end
    end
end)()

-- ============================================================
--  AUTO PICKER (Teleport method – no movement lock)
-- ============================================================
getgenv().pickerBusy = false

coroutine.wrap(function()
    while task.wait(0.2) do
        if not getgenv().autoPickerEnabled then continue end
        if getgenv().pickerBusy then continue end
        getgenv().pickerBusy = true

        pcall(function()
            local char = player.Character
            if not char then return end
            local root = char:FindFirstChild("HumanoidRootPart")
            if not root then return end

            for _, item in ipairs(Workspace:GetDescendants()) do
                if not getgenv().autoPickerEnabled then break end
                if item:IsA("Tool") and item.Parent ~= player.Backpack and item.Parent ~= char then
                    local handle = item:FindFirstChild("Handle") or item:FindFirstChildWhichIsA("BasePart")
                    if handle then
                        local dist = (root.Position - handle.Position).Magnitude
                        if dist <= getgenv().pickerRange then
                            local oldPos = root.CFrame
                            local target = handle.CFrame * CFrame.new(0, 2, 0)
                            local tween = TweenService:Create(root, TweenInfo.new(0.1, Enum.EasingStyle.Linear), {CFrame = target})
                            tween:Play()
                            tween.Completed:Wait()
                            task.wait(0.15)
                            local backTween = TweenService:Create(root, TweenInfo.new(0.1, Enum.EasingStyle.Linear), {CFrame = oldPos})
                            backTween:Play()
                            task.wait(0.2)
                        end
                    end
                end
            end
        end)

        getgenv().pickerBusy = false
    end
end)()

-- ============================================================
--  AUTO HARVEST (swings tool – free movement)
-- ============================================================
coroutine.wrap(function()
    while task.wait(0.001) do
        if not getgenv().autoHarvestEnabled then
            task.wait(0.1)
            continue
        end

        pcall(function()
            local char = player.Character
            if not char then return end
            local tool = char:FindFirstChildOfClass("Tool")
            if not tool then return end

            tool:Activate()
            task.wait(math.random(50, 150) / 1000)
            -- Some games need deactivation, uncomment if needed:
            -- pcall(function() tool:Deactivate() end)
            task.wait(getgenv().harvestSpeed / 1000)
        end)
    end
end)()

